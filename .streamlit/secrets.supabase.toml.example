# Copie o conteúdo para .streamlit/secrets.toml (arquivo ignorado pelo Git).
# No Supabase: Connect > Session pooler > View parameters.
# Use exatamente o host, porta e usuário mostrados no seu projeto.
[connections.postgresql]
dialect = "postgresql"
driver = "psycopg"
host = "aws-0-SUA-REGIAO.pooler.supabase.com"
port = 5432
database = "postgres"
username = "postgres.SEUREFERENCIADOPROJETO"
password = "SENHA_DO_BANCO_PREENCHIDA_LOCALMENTE"

[connections.postgresql.query]
sslmode = "require"

[connections.postgresql.create_engine_kwargs]
pool_pre_ping = true
pool_size = 2
max_overflow = 2

[connections.postgresql.create_engine_kwargs.connect_args]
connect_timeout = 5
