# Copie para secrets.toml somente se usar PostgreSQL.
# Sem credenciais, o dashboard utiliza automaticamente o CSV local.
[connections.postgresql]
dialect = "postgresql"
driver = "psycopg"
host = "SEU_HOST"
port = 5432
database = "SEU_BANCO"
username = "SEU_USUARIO"
password = "SUA_SENHA"

[connections.postgresql.query]
sslmode = "require"

[connections.postgresql.create_engine_kwargs.connect_args]
connect_timeout = 5
